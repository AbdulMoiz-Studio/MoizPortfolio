# ==============================================================
# Moiz Studio Contact Form Email Automation Configuration
# ==============================================================

# Gmail SMTP Configuration
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password (select App: Mail, Device: Other):
#    https://myaccount.google.com/apppasswords
SMTP_USER=contactwithabdulmoiz@gmail.com
SMTP_PASS=your-16-character-gmail-app-password

# Email Destination & Branding
OWNER_EMAIL=contactwithabdulmoiz@gmail.com
FROM_NAME="Abdul Moiz | Moiz Studio"

# Security & CORS (Production domain)
ALLOWED_ORIGIN=https://moizstudio.me

# Standalone Server Port (Optional, defaults to 3000)
PORT=3000

# ==============================================================
# Admin Panel & CMS Configuration
# ==============================================================
ADMIN_USERNAME=abdulmoiz
ADMIN_PASSWORD=shmoiz8483
SESSION_SECRET=super_secret_session_key_replace_for_production_min_32_chars
COOKIE_SECURE=false

