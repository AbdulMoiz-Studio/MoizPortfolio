{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/work/:slug",
      "destination": "/work/:slug.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/work/:slug.html"
    },
    {
      "source": "/(about|services|work|process|testimonials|contact)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
