{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/api/content",
      "destination": "/api/content"
    },
    {
      "source": "/api/admin/:match*",
      "destination": "/api/server"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/work/:slug.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/work/:slug.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/process",
      "destination": "/index.html"
    },
    {
      "source": "/testimonials",
      "destination": "/index.html"
    },
    {
      "source": "/:any((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
