<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # Route /work/name to work/name.html
  RewriteCond %{DOCUMENT_ROOT}/work/$1.html -f
  RewriteRule ^work/([^/]+)/?$ work/$1.html [L,QSA]

  # Redirect /projects/name to /work/name
  RewriteRule ^projects/([^/]+)/?$ /work/$1 [R=301,L]

  # Route sections to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(about|services|work|process|testimonials|contact)/?$ index.html [L,QSA]
</IfModule>
